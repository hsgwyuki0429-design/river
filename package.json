{
  "name": "river",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "蛇行・流路切断・三日月湖を早送りで観察する川の変遷アプリ",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
